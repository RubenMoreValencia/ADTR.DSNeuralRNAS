cat("\n================ RED ADTR: ARISTAS ================\n")
print(red_adtr$aristas)
cat("\n================ MADUREZ ECOSISTÉMICA ================\n")
print(madurez)
cat("\n================ NIVEL 4 ================\n")
print(nivel4)
cat("\n================ NIVEL 5 ================\n")
print(nivel5)
