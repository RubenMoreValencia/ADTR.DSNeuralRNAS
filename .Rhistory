# ------------------------------------------------------------
# 4. Mostrar resultados
# ------------------------------------------------------------
cat("\n================ VALIDACIÓN ADTR ================\n")
print(validacion)
cat("\n================ PUNTOS TRAZABLES ================\n")
print(puntos)
cat("\n================ M(P) INTEGRADA ================\n")
